{
  "name": "medcore-hms",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.13.0 <25" },
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run start:dev -w @medcore/api",
    "dev:web": "npm run dev -w @medcore/web",
    "build": "npm run build -w @medcore/api && npm run build -w @medcore/web",
    "lint": "npm run lint -w @medcore/api && npm run lint -w @medcore/web",
    "typecheck": "npm run typecheck -w @medcore/api && npm run typecheck -w @medcore/web",
    "test": "npm run test -w @medcore/api && npm run test:e2e -w @medcore/web",
    "test:api": "npm run test -w @medcore/api",
    "test:e2e": "npm run test:e2e -w @medcore/web",
    "db:generate": "npm run db:generate -w @medcore/api",
    "db:migrate": "npm run db:migrate -w @medcore/api",
    "db:seed": "npm run db:seed -w @medcore/api",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
