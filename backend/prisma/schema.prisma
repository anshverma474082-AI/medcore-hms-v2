generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  LAB_TECHNICIAN
  PHARMACIST
  ACCOUNTANT
  PATIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InvoiceStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum LabStatus {
  ORDERED
  RESULT_UPLOADED
  APPROVED
}

model Hospital {
  id             Int                  @id @default(autoincrement())
  name           String
  code           String               @unique
  verified       Boolean              @default(false)
  createdAt      DateTime             @default(now())
  users          User[]
  departments    Department[]
  doctors        Doctor[]
  availabilities DoctorAvailability[]
  patients       Patient[]
  appointments   Appointment[]
  records        MedicalRecord[]
  attachments    ClinicalAttachment[]
  prescriptions  Prescription[]
  invoices       Invoice[]
  labOrders      LabOrder[]
  medicines      Medicine[]
  batches        InventoryBatch[]
  dispenses      Dispense[]
  notifications  Notification[]
  auditLogs      AuditLog[]
}

model User {
  id              Int            @id @default(autoincrement())
  hospitalId      Int?
  email           String         @unique
  name            String
  passwordHash    String
  role            Role
  emailVerified   Boolean        @default(false)
  isActive        Boolean        @default(true)
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  hospital        Hospital?      @relation(fields: [hospitalId], references: [id])
  doctor          Doctor?
  patient         Patient?
  notifications   Notification[]
  auditLogs       AuditLog[]
  ordersCreated   LabOrder[]     @relation("LabOrderCreator")
  resultsUploaded LabOrder[]     @relation("LabResultUploader")
  resultsApproved LabOrder[]     @relation("LabResultApprover")
  dispenses       Dispense[]
  uploadedAttachments ClinicalAttachment[]

  @@index([hospitalId, role])
}

model Department {
  id         Int      @id @default(autoincrement())
  hospitalId Int
  name       String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctors    Doctor[]

  @@unique([hospitalId, name])
}

model Doctor {
  id             Int                  @id @default(autoincrement())
  userId         Int                  @unique
  hospitalId     Int
  departmentId   Int?
  specialisation String               @default("General")
  deletedAt      DateTime?
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital       Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department     Department?          @relation(fields: [departmentId], references: [id])
  availabilities DoctorAvailability[]
  appointments   Appointment[]
  records        MedicalRecord[]
  prescriptions  Prescription[]
  labOrders      LabOrder[]

  @@index([hospitalId, specialisation])
}

model Patient {
  id            Int             @id @default(autoincrement())
  userId        Int             @unique
  hospitalId    Int
  phone         String          @default("")
  phoneVerified Boolean         @default(false)
  birthDateEncrypted  String    @default("")
  sexEncrypted        String    @default("")
  bloodGroupEncrypted String    @default("")
  emergencyContactNameEncrypted  String @default("")
  emergencyContactPhoneEncrypted String @default("")
  addressEncrypted               String @default("")
  deletedAt     DateTime?
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital      Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  records       MedicalRecord[]
  prescriptions Prescription[]
  invoices      Invoice[]
  labOrders     LabOrder[]
  dispenses     Dispense[]

  @@index([hospitalId])
}

model DoctorAvailability {
  id          Int      @id @default(autoincrement())
  hospitalId  Int
  doctorId    Int
  weekday     Int
  startMinute Int
  endMinute   Int
  slotMinutes Int      @default(30)
  active      Boolean  @default(true)
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, weekday, startMinute, endMinute])
  @@index([hospitalId, doctorId])
}

model Appointment {
  id           Int               @id @default(autoincrement())
  hospitalId   Int
  patientId    Int
  doctorId     Int
  startsAt     DateTime
  endsAt       DateTime
  status       AppointmentStatus @default(PENDING)
  emergency    Boolean           @default(false)
  reason       String            @default("")
  deletedAt    DateTime?
  createdAt    DateTime          @default(now())
  hospital     Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient      Patient           @relation(fields: [patientId], references: [id])
  doctor       Doctor            @relation(fields: [doctorId], references: [id])
  record       MedicalRecord?
  prescription Prescription?
  invoice      Invoice?
  labOrders    LabOrder[]

  @@index([hospitalId, startsAt])
  @@index([patientId, startsAt])
  @@index([doctorId, startsAt])
}

model MedicalRecord {
  id                      Int         @id @default(autoincrement())
  hospitalId              Int
  appointmentId           Int         @unique
  patientId               Int
  doctorId                Int
  chiefComplaintEncrypted String      @default("")
  symptomsEncrypted       String      @default("")
  diagnosisEncrypted      String
  treatmentPlanEncrypted  String      @default("")
  allergiesEncrypted      String      @default("")
  medicalHistoryEncrypted String      @default("")
  familyHistoryEncrypted  String      @default("")
  surgicalHistoryEncrypted String     @default("")
  vaccinationHistoryEncrypted String  @default("")
  bloodPressure           String      @default("")
  pulseBpm                Int?
  temperatureC            Decimal?    @db.Decimal(4, 1)
  spo2Percent             Int?
  weightKg                Decimal?    @db.Decimal(5, 2)
  heightCm                Decimal?    @db.Decimal(5, 1)
  bmi                     Decimal?    @db.Decimal(5, 2)
  signedAt                DateTime?
  signatureDigest         String      @default("")
  createdAt               DateTime    @default(now())
  hospital                Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointment             Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient                 Patient     @relation(fields: [patientId], references: [id])
  doctor                  Doctor      @relation(fields: [doctorId], references: [id])
  attachments             ClinicalAttachment[]

  @@index([hospitalId, patientId, createdAt])
}

model ClinicalAttachment {
  id                Int          @id @default(autoincrement())
  hospitalId        Int
  recordId          Int
  uploadedById      Int
  originalName      String
  mimeType          String
  sizeBytes         Int
  encryptedContents Bytes
  createdAt         DateTime     @default(now())
  hospital          Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  record            MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  uploadedBy        User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([hospitalId, recordId, createdAt])
}

model Prescription {
  id                    Int                @id @default(autoincrement())
  hospitalId            Int
  appointmentId         Int                @unique
  patientId             Int
  doctorId              Int
  instructionsEncrypted String             @default("")
  signedAt              DateTime?
  signatureDigest       String             @default("")
  createdAt             DateTime           @default(now())
  hospital              Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointment           Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient               Patient            @relation(fields: [patientId], references: [id])
  doctor                Doctor             @relation(fields: [doctorId], references: [id])
  items                 PrescriptionItem[]
  dispense              Dispense?

  @@index([hospitalId, patientId, createdAt])
}

model PrescriptionItem {
  id             Int          @id @default(autoincrement())
  prescriptionId Int
  medicineName   String
  dosage         String
  frequency      String
  duration       String
  instructions   String       @default("")
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             Int            @id @default(autoincrement())
  hospitalId     Int
  appointmentId  Int            @unique
  patientId      Int
  amountMinor    Int
  currency       String         @default("INR")
  status         InvoiceStatus  @default(UNPAID)
  gatewayOrderId String?        @unique
  createdAt      DateTime       @default(now())
  paidAt         DateTime?
  hospital       Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointment    Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient        Patient        @relation(fields: [patientId], references: [id])
  items          InvoiceItem[]
  payments       PaymentEvent[]

  @@index([hospitalId, patientId, status])
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  description String
  quantity    Int
  unitMinor   Int
  totalMinor  Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model PaymentEvent {
  id              Int      @id @default(autoincrement())
  invoiceId       Int
  provider        String
  providerEventId String   @unique
  outcome         String
  amountMinor     Int
  currency        String
  createdAt       DateTime @default(now())
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model LabOrder {
  id                 Int         @id @default(autoincrement())
  hospitalId         Int
  appointmentId      Int
  patientId          Int
  doctorId           Int
  testName           String
  notesEncrypted     String      @default("")
  resultEncrypted    String      @default("")
  status             LabStatus   @default(ORDERED)
  orderedById        Int
  resultUploadedById Int?
  approvedById       Int?
  createdAt          DateTime    @default(now())
  uploadedAt         DateTime?
  approvedAt         DateTime?
  hospital           Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointment        Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient            Patient     @relation(fields: [patientId], references: [id])
  doctor             Doctor      @relation(fields: [doctorId], references: [id])
  orderedBy          User        @relation("LabOrderCreator", fields: [orderedById], references: [id])
  resultUploadedBy   User?       @relation("LabResultUploader", fields: [resultUploadedById], references: [id])
  approvedBy         User?       @relation("LabResultApprover", fields: [approvedById], references: [id])

  @@unique([appointmentId, testName])
  @@index([hospitalId, status])
}

model Medicine {
  id           Int              @id @default(autoincrement())
  hospitalId   Int
  name         String
  sku          String
  category     String           @default("General")
  unit         String           @default("unit")
  reorderLevel Int              @default(0)
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  hospital     Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  batches      InventoryBatch[]

  @@unique([hospitalId, sku])
  @@unique([hospitalId, name])
}

model InventoryBatch {
  id                Int      @id @default(autoincrement())
  hospitalId        Int
  medicineId        Int
  batchNumber       String
  expiryDate        DateTime @db.Date
  quantityReceived  Int
  quantityRemaining Int
  unitCostMinor     Int
  receivedAt        DateTime @default(now())
  hospital          Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  medicine          Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([medicineId, batchNumber])
  @@index([hospitalId, expiryDate])
}

model Dispense {
  id             Int             @id @default(autoincrement())
  hospitalId     Int
  prescriptionId Int             @unique
  patientId      Int
  dispensedById  Int
  createdAt      DateTime        @default(now())
  hospital       Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  prescription   Prescription    @relation(fields: [prescriptionId], references: [id])
  patient        Patient         @relation(fields: [patientId], references: [id])
  dispensedBy    User            @relation(fields: [dispensedById], references: [id])
  items          DispensedItem[]
}

model DispensedItem {
  id                 Int      @id @default(autoincrement())
  dispenseId         Int
  prescriptionItemId Int
  medicineName       String
  quantity           Int
  batchNumber        String
  dispense           Dispense @relation(fields: [dispenseId], references: [id], onDelete: Cascade)
}

model Notification {
  id         Int       @id @default(autoincrement())
  hospitalId Int
  userId     Int
  category   String
  title      String
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  hospital   Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id         Int       @id @default(autoincrement())
  hospitalId Int?
  userId     Int?
  action     String
  entity     String
  entityId   Int?
  ip         String    @default("")
  createdAt  DateTime  @default(now())
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([hospitalId, createdAt])
}
