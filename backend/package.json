{
  "name": "@medcore/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --coverage",
    "test:integration": "jest --runInBand --config jest.integration.config.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.6.1",
    "@nestjs/core": "^12.6.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.6.1",
    "@nestjs/platform-socket.io": "^12.6.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/websockets": "^12.6.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.41.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.3",
    "razorpay": "^2.9.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
