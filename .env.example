# Copy to .env and replace each secret. .env is ignored by Git.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://medcore:medcore@localhost:5432/medcore?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
CLINICAL_ENCRYPTION_KEY=base64-encoded-32-byte-key
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:3000
API_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
DEMO_PASSWORD=DemoPass123!

# Razorpay test-mode credentials.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend email provider.
RESEND_API_KEY=
EMAIL_FROM=MedCore <no-reply@example.com>

# Twilio SMS provider.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
